meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Test User",
    "email": "test.user@example.com",
    "password": "testpass123",
    "role": "student"
  }
}

docs {
  Creates a new account. The password is hashed with bcrypt before storage,
  never stored in plain text.

  `role` is optional and defaults to "student"; allowed values are
  student, mentor, placement_officer, admin.

  Returns 201 with a JWT + the created user on success, 400 if a required
  field is missing or the role is invalid, 409 if the email is already
  registered.
}
